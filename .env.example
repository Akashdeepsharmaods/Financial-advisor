# ================================================================
# EMAIL NOTIFICATION CONFIGURATION (Nodemailer / SMTP)
# ================================================================
# For Gmail:
# 1. Use SMTP_HOST=smtp.gmail.com and SMTP_PORT=587
# 2. Use your Gmail address for SMTP_USER and ADVISOR_EMAIL
# 3. Generate an "App Password" at https://myaccount.google.com/apppasswords
#    (Do NOT use your normal Gmail account password)
# ================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
ADVISOR_EMAIL=your-email@gmail.com
